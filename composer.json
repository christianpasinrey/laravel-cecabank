{
    "name": "cpr/laravel-cecabank",
    "description": "Cecabank TPV integration for Laravel — models, signature engine, polymorphic payment transactions, events and webhook routes. Frontend-agnostic: ship your own Blade/Vue/React UI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "payments", "tpv", "cecabank", "ceca"],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Cpr\\Cecabank\\": "src/",
            "Cpr\\Cecabank\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cpr\\Cecabank\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cpr\\Cecabank\\CecabankServiceProvider"
            ],
            "aliases": {
                "Cecabank": "Cpr\\Cecabank\\Facades\\Cecabank"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
